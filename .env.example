APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_HOST=127.0.0.1

# Password required to log in to the dashboard
APP_PASSWORD=choose_a_password_here

# Random string used to sign session cookies — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace_with_a_long_random_string

AIRTABLE_TOKEN=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID_DEV=appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID_PROD=appXXXXXXXXXXXXXX

# Needed for both the dashboard photo scan and the manual Q&A chat (credit purchased)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
